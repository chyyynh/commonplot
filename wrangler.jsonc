/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "newsence-core",
	"main": "src/index.ts",
	"workers_dev": false,
	"compatibility_date": "2026-08-30",
	/**
	 * A rebuild of 500k resources enqueues 10k sync batches, then lists and
	 * prunes 10k search item pages; the sync queue does the uploads.
	 * Workflows count subrequests per instance, so keep headroom.
	 */
	"limits": {
		"cpu_ms": 180000,
		"subrequests": 5000000,
	},
	/** PDF parsers stream uploaded PDFs from R2; their models and scratch disks are intentionally ephemeral. */
	"containers": [
		{
			"class_name": "ZoteroSdt",
			"scheduling_policy": "durable_object",
			/** Surfaces the document-worker's stdout/stderr (queue saturation, parser failures) in Workers Logs. */
			"observability": { "logs": { "enabled": true } },
			"images": {
				"zotero-sdt": { "dockerfile": "./containers/zotero-sdt/Dockerfile" },
			},
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "ZOTERO_PDF",
				"class_name": "ZoteroSdt",
			},
			{
				"name": "YOUTUBE_CAPTIONS",
				"class_name": "YouTubeCaptionFetcher",
			},
		],
	},
	"migrations": [
		{
			"tag": "grobid-v1",
			"new_sqlite_classes": ["GrobidContainer"],
		},
		{
			"tag": "zotero-sdt-v1",
			"new_sqlite_classes": ["ZoteroSdtContainer"],
		},
		{
			"tag": "youtube-captions-v1",
			"new_sqlite_classes": ["YouTubeCaptionFetcher"],
		},
		{
			"tag": "grobid-removed-v1",
			"deleted_classes": ["GrobidContainer"],
		},
		{
			"tag": "zotero-sdt-durable-object-v1",
			"new_sqlite_classes": ["ZoteroSdt"],
			"deleted_classes": ["ZoteroSdtContainer"],
		},
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true,
		},
		"traces": {
			"enabled": true,
			"persist": true,
			"head_sampling_rate": 0.05,
		},
	},
	/**
	 * Schedule Triggers
	 * https://developers.cloudflare.com/workers/configuration/cron-triggers/
	 */
	"triggers": {
		"crons": [
			"*/5 * * * *", // RSS monitor, incl. YouTube channel feeds (every 5 minutes)
			"0 */6 * * *", // Twitter monitor (every 6 hours)
		],
	},
	/** AI Search is a derived index; this Queue keeps it off canonical Resource Workflows. */
	"queues": {
		"producers": [
			{
				"binding": "RESOURCE_SEARCH_SYNC_QUEUE",
				"queue": "resource-search-sync",
			},
		],
		"consumers": [
			{
				"queue": "resource-search-sync",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 3,
				/** A Resource that keeps changing mid-sync gets time to settle before its retries run out. */
				"retry_delay": 30,
				/** Exhausted syncs stay inspectable and replayable instead of being dropped. */
				"dead_letter_queue": "resource-search-sync-dlq",
			},
		],
	},
	/**
	 * Workflows
	 * https://developers.cloudflare.com/workflows/
	 */
	"workflows": [
		{
			"binding": "RESOURCE_PROCESSING_V2_WORKFLOW",
			"name": "newsence-resource-processing-v2",
			"class_name": "ResourceProcessingV2Workflow",
		},
		{
			"binding": "RESOURCE_TRANSLATION_V2_WORKFLOW",
			"name": "newsence-resource-translation-v2",
			"class_name": "ResourceTranslationV2Workflow",
			"default_retention": { "success_retention": "7 days", "error_retention": "7 days" },
		},
		{
			"binding": "SEARCH_INDEX_REBUILD_WORKFLOW",
			"name": "newsence-search-index-rebuild",
			"class_name": "SearchIndexRebuildWorkflow",
			/** 500k resources need 10k enqueue steps before pruning and readiness checks. */
			"limits": { "steps": 25000 },
		},
		{
			"binding": "RESOURCE_ENTITY_BACKFILL_WORKFLOW",
			"name": "newsence-resource-entity-backfill",
			"class_name": "ResourceEntityBackfillWorkflow",
			/** One extraction step per Resource; run a month or less per instance. */
			"limits": { "steps": 10000 },
		},
	],
	/**
	 * Workers AI Binding
	 * https://developers.cloudflare.com/workers-ai/get-started/workers-wrangler/
	 */
	"ai": {
		"binding": "AI",
	},
	"ai_search": [
		{
			"binding": "AI_SEARCH",
			"instance_name": "newsence-corpus-v7",
			"remote": true,
		},
	],
	/**
	 * Hyperdrive — PlanetScale PostgreSQL connection pooling
	 * https://developers.cloudflare.com/hyperdrive/
	 */
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "5d7b16cf287e4dcc8b36d43461ccbf5c",
		},
	],
	/** Cloudflare Images — hosted resource previews and creator avatars. */
	"images": {
		"binding": "IMAGES",
	},
	/**
	 * R2 buckets.
	 *
	 * `R2` — shared resource blob storage. The app worker owns uploaded
	 *   blob lifecycle. Core reads uploaded PDFs for local extraction and, only
	 *   with a Web-issued grant after a hard defect, temporary provider upload.
	 */
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "newsence",
		},
	],
	"services": [
		{
			"binding": "APP",
			"service": "newsence-web-tanstack",
			"entrypoint": "DomainRpc",
		},
	],
	/**
	 * Smart Placement — run close to database
	 */
	"placement": {
		"mode": "smart",
	},
	/**
	 * `AI_GATEWAY_ENVIRONMENT` — trusted deployment label attached to Gateway logs.
	 * System inference is pinned to the pre-created `core-ingest` Gateway at its
	 * domain call sites; local scripts override this label to `development`.
	 *
	 * Required secrets:
	 * - KAITO_API_KEY enables Twitter ingestion enrichment.
	 * - YOUTUBE_API_KEY enables YouTube transcript/channel enrichment.
	 * - OPENALEX_API_KEY enables exact paper metadata enrichment.
	 */
	"secrets": {
		"required": ["KAITO_API_KEY", "YOUTUBE_API_KEY", "OPENALEX_API_KEY"],
	},
	"vars": {
		"AI_GATEWAY_ENVIRONMENT": "production",
	},
}
