/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "newsence-core",
	"main": "src/index.ts",
	"workers_dev": false,
	"compatibility_date": "2026-08-30",
	/**
	 * LiteParse is CPU-bound WASM; its longest PDF Workflow step has a three-minute
	 * timeout. A full AI Search rebuild also performs one upload subrequest per
	 * corpus item, so keep enough headroom for the 500k-file instance limit.
	 */
	"limits": {
		"cpu_ms": 180000,
		"subrequests": 1000000
	},
	/**
	 * Bundle `.wasm` files as compiled `WebAssembly.Module` imports. Used by the
	 * PDF text-extraction stage (`@llamaindex/liteparse-wasm`) in
	 * `src/ingest/platforms/pdf.ts`. `fallthrough` keeps default rules for any
	 * other module types.
	 */
	"rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true,
			"persist": true,
			"head_sampling_rate": 0.05
		}
	},
	/**
	 * Schedule Triggers
	 * https://developers.cloudflare.com/workers/configuration/cron-triggers/
	 */
	"triggers": {
		"crons": [
			"*/5 * * * *", // RSS monitor, incl. YouTube channel feeds (every 5 minutes)
			"0 */6 * * *" // Twitter monitor (every 6 hours)
		]
	},
	/** AI Search is a derived index; this Queue keeps it off canonical Resource Workflows. */
	"queues": {
		"producers": [
			{
				"binding": "RESOURCE_SEARCH_SYNC_QUEUE",
				"queue": "resource-search-sync"
			}
		],
		"consumers": [
			{
				"queue": "resource-search-sync",
				"max_batch_size": 10,
				"max_batch_timeout": 5
			}
		]
	},
	/**
	 * Workflows
	 * https://developers.cloudflare.com/workflows/
	 */
	"workflows": [
		{
			"binding": "RESOURCE_PROCESSING_V2_WORKFLOW",
			"name": "newsence-resource-processing-v2",
			"class_name": "ResourceProcessingV2Workflow"
		},
		{
			"binding": "RESOURCE_TRANSLATION_V2_WORKFLOW",
			"name": "newsence-resource-translation-v2",
			"class_name": "ResourceTranslationV2Workflow",
			"default_retention": { "success_retention": "1 day", "error_retention": "7 days" }
		},
		{
			"binding": "SEARCH_INDEX_REBUILD_WORKFLOW",
			"name": "newsence-search-index-rebuild",
			"class_name": "SearchIndexRebuildWorkflow"
		}
	],
	/**
	 * Workers AI Binding
	 * https://developers.cloudflare.com/workers-ai/get-started/workers-wrangler/
	 */
	"ai": {
		"binding": "AI"
	},
	"ai_search": [
		{
			"binding": "AI_SEARCH",
			"instance_name": "newsence-corpus-v6",
			"remote": true
		},
		{
			"binding": "RELATED_SEARCH",
			"instance_name": "newsence-related-v1",
			"remote": true
		}
	],
	/**
	 * Hyperdrive — PlanetScale PostgreSQL connection pooling
	 * https://developers.cloudflare.com/hyperdrive/
	 */
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "5d7b16cf287e4dcc8b36d43461ccbf5c"
		}
	],
	/** Cloudflare Images — hosted resource previews and creator avatars. */
	"images": {
		"binding": "IMAGES"
	},
	/**
	 * R2 buckets.
	 *
	 * `R2` — shared resource blob storage. The app worker owns uploaded
	 *   blob lifecycle. Core reads uploaded PDFs for local extraction and, only
	 *   with a Web-issued grant after a hard defect, temporary provider upload.
	 */
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "newsence"
		}
	],
	"services": [
		{
			"binding": "APP",
			"service": "newsence-web-tanstack",
			"entrypoint": "DomainRpc"
		}
	],
	/**
	 * Smart Placement — run close to database
	 */
	"placement": {
		"mode": "smart"
	},
	/**
	 * `AI_GATEWAY_ENVIRONMENT` — trusted deployment label attached to Gateway logs.
	 * System inference is pinned to the pre-created `core-ingest` Gateway at its
	 * domain call sites; local scripts override this label to `development`.
	 *
	 * Required secrets:
	 * - KAITO_API_KEY enables Twitter ingestion enrichment.
	 * - YOUTUBE_API_KEY enables YouTube transcript/channel enrichment.
	 * - OPENALEX_API_KEY enables exact paper metadata enrichment.
	 * - LLAMA_CLOUD_API_KEY and LLAMA_CLOUD_PROJECT_ID identify this
	 *   deployment's Llama Cloud project; development uses separate values.
	 */
	"secrets": {
		"required": ["KAITO_API_KEY", "YOUTUBE_API_KEY", "OPENALEX_API_KEY", "LLAMA_CLOUD_API_KEY", "LLAMA_CLOUD_PROJECT_ID"]
	},
	"vars": {
		"AI_GATEWAY_ENVIRONMENT": "production"
	}
}
