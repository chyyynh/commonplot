{
	"name": "newsence-core",
	"version": "0.0.0",
	"private": true,
	"packageManager": "pnpm@11.9.0",
	"type": "module",
	"scripts": {
		"backfill:resource-references": "node --experimental-strip-types scripts/backfill-resource-references.mjs",
		"deploy": "wrangler deploy",
		"deploy:dry-run": "pnpm run typecheck && wrangler deploy --dry-run",
		"check:bibliography": "node --experimental-strip-types scripts/check-bibliography.mjs",
		"check:db-contract": "node --experimental-strip-types scripts/check-database-contract.mjs",
		"check:llama-parse-policy": "node --experimental-strip-types scripts/check-llama-parse-policy.mjs",
		"check:markdown-translation": "node --experimental-strip-types scripts/check-markdown-translation.mjs",
		"check:resource-identity": "node --experimental-strip-types scripts/check-resource-identity.mjs",
		"check:platform-materialization": "node --experimental-strip-types scripts/check-platform-materialization.mjs",
		"check:twitter-provider": "node --experimental-strip-types scripts/check-twitter-provider.mjs",
		"check:startup": "wrangler check startup",
		"dev": "wrangler dev --test-scheduled --var AI_GATEWAY_ENVIRONMENT:development",
		"start": "wrangler dev --test-scheduled --var AI_GATEWAY_ENVIRONMENT:development",
		"cf-typegen": "wrangler types --env-interface CoreBindings -c wrangler.jsonc",
		"typecheck": "pnpm cf-typegen && pnpm check:bibliography && pnpm check:db-contract && pnpm check:llama-parse-policy && pnpm check:markdown-translation && pnpm check:resource-identity && pnpm check:platform-materialization && pnpm check:twitter-provider && tsc --noEmit",
		"typecheck:types": "wrangler types --check --env-interface CoreBindings -c wrangler.jsonc",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"dependencies": {
		"@extractus/article-extractor": "^9.0.1",
		"@extractus/feed-extractor": "8.0.3",
		"@llamaindex/liteparse-wasm": "2.13.1",
		"@llamaindex/llama-cloud": "2.15.0",
		"ai": "7.0.58",
		"drizzle-orm": "^0.45.2",
		"mdast-util-from-markdown": "^2.0.3",
		"mdast-util-frontmatter": "^2.0.1",
		"mdast-util-gfm": "^3.1.0",
		"mdast-util-math": "^3.0.0",
		"mdast-util-to-markdown": "^2.1.2",
		"micromark-extension-frontmatter": "^2.0.0",
		"micromark-extension-gfm": "^3.0.0",
		"micromark-extension-math": "^3.1.0",
		"pg": "^8.22.0",
		"workers-ai-provider": "4.0.0",
		"youtube-transcript": "1.3.0",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@types/mdast": "^4.0.4",
		"@types/node": "^22.19.7",
		"@types/pg": "^8.20.0",
		"typescript": "^5.9.3",
		"wrangler": "^4.125.0"
	}
}
