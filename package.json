{
	"name": "newsence-core",
	"version": "0.0.0",
	"private": true,
	"packageManager": "pnpm@11.9.0",
	"type": "module",
	"scripts": {
		"deploy": "wrangler deploy",
		"deploy:dry-run": "pnpm run typecheck && wrangler deploy --dry-run",
		"check:startup": "wrangler check startup",
		"dev": "wrangler dev --test-scheduled --var AI_GATEWAY_ENVIRONMENT:development",
		"start": "wrangler dev --test-scheduled --var AI_GATEWAY_ENVIRONMENT:development",
		"cf-typegen": "wrangler types --env-interface CoreBindings -c wrangler.jsonc",
		"typecheck": "tsc --noEmit",
		"typecheck:types": "wrangler types --check --env-interface CoreBindings -c wrangler.jsonc",
		"lint": "pnpm lint:oxlint && pnpm format:check",
		"lint:fix": "oxlint . --fix && pnpm format",
		"lint:oxlint": "oxlint . --deny-warnings --report-unused-disable-directives",
		"format:check": "oxfmt --check \"**/*.{js,cjs,mjs,ts,tsx,json,jsonc}\"",
		"format": "oxfmt --write \"**/*.{js,cjs,mjs,ts,tsx,json,jsonc}\""
	},
	"dependencies": {
		"@ai-sdk/openai": "^4.0.73",
		"@cloudflare/containers": "^0.3.7",
		"@extractus/feed-extractor": "8.0.3",
		"@llamaindex/llama-cloud": "2.16.0",
		"@mozilla/readability": "0.6.0",
		"ai": "7.0.112",
		"drizzle-orm": "^0.45.3",
		"fast-xml-parser": "5.11.1",
		"franc-min": "^6.2.0",
		"hast-util-from-html": "^2.0.3",
		"hast-util-sanitize": "5.0.2",
		"hast-util-to-html": "9.0.5",
		"hast-util-to-mdast": "^10.1.2",
		"hast-util-to-text": "4.0.2",
		"linkedom": "0.18.13",
		"mdast-util-from-markdown": "^2.0.3",
		"mdast-util-frontmatter": "^2.0.1",
		"mdast-util-gfm": "^3.1.0",
		"mdast-util-math": "^3.0.0",
		"mdast-util-to-hast": "13.2.1",
		"mdast-util-to-markdown": "^2.1.2",
		"mdast-util-to-markdown-cjk-friendly": "1.0.0",
		"mdast-util-to-markdown-cjk-friendly-gfm-strikethrough": "1.0.0",
		"mdast-util-to-string": "4.0.0",
		"micromark-extension-cjk-friendly": "2.0.1",
		"micromark-extension-cjk-friendly-gfm-strikethrough": "2.0.1",
		"micromark-extension-frontmatter": "^2.0.0",
		"micromark-extension-gfm": "^3.0.0",
		"micromark-extension-math": "^3.1.0",
		"normalize-url": "9.0.1",
		"opencc-js": "^1.4.2",
		"pg": "^8.23.0",
		"strip-indent": "4.1.1",
		"structured-document-text": "github:zotero/structured-document-text#7963c11faac4595be3bbe86b7574704a22c67bed",
		"workers-ai-provider": "4.0.0",
		"youtube-transcript": "1.3.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/hast": "3.0.5",
		"@types/mdast": "^4.0.4",
		"@types/node": "^22.20.3",
		"@types/pg": "^8.23.1",
		"oxfmt": "0.70.0",
		"oxlint": "1.85.0",
		"typescript": "^7.0.2",
		"wrangler": "^4.136.3"
	}
}
