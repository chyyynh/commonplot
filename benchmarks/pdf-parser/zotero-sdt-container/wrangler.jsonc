{
	"$schema": "../../../node_modules/wrangler/config-schema.json",
	"name": "newsence-zotero-sdt-spike",
	"main": "./worker.ts",
	"compatibility_date": "2026-09-03",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"containers": [
		{
			"class_name": "ZoteroSdtContainer",
			"image": "./Dockerfile",
			"instance_type": "basic",
			"max_instances": 1
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "ZOTERO_SDT", "class_name": "ZoteroSdtContainer" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["ZoteroSdtContainer"] }],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}
